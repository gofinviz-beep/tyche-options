# Tyche Options — Environment Configuration
# Only secrets and infrastructure settings belong here.
# All other config (risk limits, watchlist, scan params, etc.) is stored
# in db/config.db and editable from the Settings UI.
#
# On first startup, any TYCHE_* config values found here are automatically
# migrated to config.db.  After that, only the variables below are read
# from .env — everything else comes from config.db.

# --- Broker (Tradier) ---
TYCHE_TRADIER_API_TOKEN=your-tradier-api-token
TYCHE_TRADIER_ACCOUNT_ID=your-account-id
TYCHE_TRADIER_SANDBOX=true

# --- LLM (Google Gemini) ---
TYCHE_GEMINI_API_KEY=your-gemini-api-key

# --- Market Data (Polygon.io / Massive.com) ---
TYCHE_POLYGON_API_KEY=your-polygon-api-key
TYCHE_POLYGON_BASE_URL=https://api.polygon.io
TYCHE_POLYGON_RATE_LIMIT_RPM=100

# Alpha Vantage free key (earnings calendar fallback)
TYCHE_ALPHA_VANTAGE_KEY=demo

# --- Data Storage ---
TYCHE_DATA_DIR=data
TYCHE_DB_DIR=db

# --- Observability ---
TYCHE_LOG_LEVEL=INFO
TYCHE_OTEL_ENABLED=true

# --- Database ---
# Leave empty for SQLite default (db/tyche.db). Set for PostgreSQL.
TYCHE_DATABASE_URL=
