# Tyche Options — Environment Configuration
# Copy to .env and fill in your values

# --- Broker (Tradier) ---
TYCHE_TRADIER_API_TOKEN=your-tradier-api-token
TYCHE_TRADIER_ACCOUNT_ID=your-account-id
TYCHE_TRADIER_SANDBOX=true

# --- LLM (Google Gemini) ---
TYCHE_GEMINI_API_KEY=your-gemini-api-key
TYCHE_GEMINI_MODEL_FAST=gemini-3-flash-preview
TYCHE_GEMINI_MODEL_DEEP=gemini-3.1-pro-preview

# --- Market Data (Polygon.io / Massive.com) ---
# Get your API key at https://massive.com or https://polygon.io
TYCHE_POLYGON_API_KEY=your-polygon-api-key
TYCHE_POLYGON_BASE_URL=https://api.polygon.io
TYCHE_POLYGON_RATE_LIMIT_RPM=100

# Alpha Vantage free key (earnings calendar fallback)
TYCHE_ALPHA_VANTAGE_KEY=demo
# Manual earnings date overrides (JSON dict of symbol -> YYYY-MM-DD)
# TYCHE_EARNINGS_OVERRIDES={"PL": "2026-06-15", "AAPL": "2026-07-25"}

# --- Data Storage ---
# Local directory for cached OHLCV Parquet files
TYCHE_DATA_DIR=data

# --- Universe Filtering ---
TYCHE_MIN_MARKET_CAP_MILLIONS=500.0
TYCHE_MIN_AVG_VOLUME=500000
TYCHE_MIN_STOCK_PRICE=5.0

# --- Conviction Engine ---
TYCHE_EMA_FAST_PERIOD=8
TYCHE_EMA_SLOW_PERIOD=21
TYCHE_PULLBACK_PROXIMITY_PCT=2.0
TYCHE_BOOTSTRAP_DAYS=120

# --- Risk Limits ---
TYCHE_MAX_RISK_PER_TRADE_PCT=5.0
TYCHE_MAX_ACCOUNT_EXPOSURE_PCT=70.0
TYCHE_MAX_CONCENTRATION_PER_TICKER_PCT=25.0
TYCHE_MAX_OPEN_POSITIONS=8
TYCHE_MAX_NEW_TRADES_PER_DAY=3
TYCHE_MAX_CONTRACTS_PER_POSITION=40
TYCHE_MIN_MARKET_CAP_BILLIONS=1.0
TYCHE_PREVIEW_ONLY_MODE=true

# --- Wheel Settings ---
TYCHE_CSP_TARGET_DTE_MIN=3
TYCHE_CSP_TARGET_DTE_MAX=14
TYCHE_CC_TARGET_DTE_MIN=3
TYCHE_CC_TARGET_DTE_MAX=14
TYCHE_MIN_ANNUALIZED_RETURN_PCT=15.0

# --- Workflow ---
TYCHE_MORNING_SCAN_TIME=09:35
TYCHE_ORDER_MONITOR_INTERVAL_MIN=15
TYCHE_MIDDAY_REVIEW_TIME=12:30
TYCHE_EOD_JOURNAL_TIME=15:50

# --- Watchlist (Optional) ---
# If empty, the morning scan discovers stocks dynamically from the data store
# using volume, price, and dollar-volume filters. Set specific symbols here
# to override with a curated list.
# TYCHE_WATCHLIST_SYMBOLS=["PL","AAPL","MSFT","GOOG","TSLA","AMZN","NVDA","META"]
TYCHE_WATCHLIST_SYMBOLS=[]

# --- Database ---
TYCHE_DATABASE_URL=sqlite+aiosqlite:///tyche.db
