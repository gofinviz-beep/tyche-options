# Copy to config.env and source before deploy:
#   source infra/gcp/config.env
#
# Deploy principal needs: Artifact Registry writer, Cloud Run admin,
# Cloud Scheduler admin, and roles/iam.serviceAccountUser on tyche-jobs.

export TYCHE_GCP_PROJECT_ID=tyche-platform
export TYCHE_GCP_REGION=us-central1
export TYCHE_GCS_BUCKET=tyche-data-prod
export TYCHE_GCS_PREFIX=

# Artifact Registry image (built from backend/Dockerfile.jobs)
export TYCHE_JOBS_IMAGE=us-central1-docker.pkg.dev/tyche-platform/tyche/jobs:latest

# Runtime service account (workload identity — no JSON keys)
export TYCHE_JOBS_SA=tyche-jobs@tyche-platform.iam.gserviceaccount.com

# Scheduler invokes jobs as this SA (needs run.invoker on each job)
export TYCHE_SCHEDULER_SA=tyche-workflow@tyche-platform.iam.gserviceaccount.com

# Cloud Run Job task env (all jobs)
export TYCHE_JOB_ENV="TYCHE_DATA_BACKEND=gcs,TYCHE_GCS_BUCKET=${TYCHE_GCS_BUCKET},TYCHE_GCP_PROJECT_ID=${TYCHE_GCP_PROJECT_ID},TYCHE_RUN_ENV=prod,TYCHE_LOAD_GCP_SECRETS=true"
